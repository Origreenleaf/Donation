# To get it as a plain data frame instead of a formatted gt object:
table1_df <- as_tibble(table1)
group_var <- "Does the patient know about illness"
continuous_vars  <- c("Age", "Monthly Income (10k)", "Total Treatment Expense (100k)")
categorical_vars <- c("ECOG Performance Status", "Pain Category", "Metastatic Cancer",
"Education", "Sex", "Marital Status", "Primary Caregiver", "Division_Group")
df <- an1_model  # your cleaned, model-ready data frame
group_var <- "Does the patient know about illness"
continuous_vars  <- c("Age", "Monthly Income (10k)", "Total Treatment Expense (100k)")
categorical_vars <- c("ECOG Performance Status", "Pain Category", "Metastatic Cancer",
"Education", "Sex", "Marital Status", "Primary Caregiver", "Division_Group")
df <- an1_trimmed  # your cleaned, model-ready data frame
grp_no  <- df %>% filter(.data[[group_var]] == "No")
grp_yes <- df %>% filter(.data[[group_var]] == "Yes")
# --- Continuous variables: mean (SD), Wilcoxon rank-sum p-value ---
cont_rows <- map_dfr(continuous_vars, function(v) {
p <- wilcox.test(grp_no[[v]], grp_yes[[v]])$p.value
tibble(
Characteristic = v,
Level = "",
`Not Disclosed` = sprintf("%.2f (%.2f)", mean(grp_no[[v]], na.rm=TRUE), sd(grp_no[[v]], na.rm=TRUE)),
Disclosed       = sprintf("%.2f (%.2f)", mean(grp_yes[[v]], na.rm=TRUE), sd(grp_yes[[v]], na.rm=TRUE)),
p_value = p
)
})
# --- Categorical variables: n (%), chi-square p-value ---
cat_rows <- map_dfr(categorical_vars, function(v) {
tab <- table(df[[v]], df[[group_var]])
p <- chisq.test(tab)$p.value
header <- tibble(Characteristic = v, Level = "(overall)",
`Not Disclosed` = "", Disclosed = "", p_value = p)
levels_df <- map_dfr(rownames(tab), function(lvl) {
n_no  <- tab[lvl, "No"];  pct_no  <- 100 * n_no  / nrow(grp_no)
n_yes <- tab[lvl, "Yes"]; pct_yes <- 100 * n_yes / nrow(grp_yes)
tibble(
Characteristic = "", Level = paste0("  ", lvl),
`Not Disclosed` = sprintf("%d (%.1f%%)", n_no, pct_no),
Disclosed       = sprintf("%d (%.1f%%)", n_yes, pct_yes),
p_value = NA_real_
)
})
bind_rows(header, levels_df)
})
table1_df <- bind_rows(cont_rows, cat_rows) %>%
mutate(p_value = ifelse(is.na(p_value), "",
ifelse(p_value < 0.001, "<0.001", sprintf("%.3f", p_value))))
# --- Render with gt, consistent with every other table in this project ---
table1_gt <- table1_df %>%
gt() %>%
tab_header(title = "Table 1. Patient Characteristics by Illness Disclosure Status") %>%
cols_label(
Characteristic = "Characteristic", Level = "",
`Not Disclosed` = sprintf("Not Disclosed (n=%d)", nrow(grp_no)),
Disclosed       = sprintf("Disclosed (n=%d)", nrow(grp_yes)),
p_value = "p-value"
) %>%
tab_style(style = cell_text(weight = "bold"), locations = cells_body(columns = Characteristic))
table1_gt

an1<-nicrh_by_val%>%select(`Does the patient know about illness`, `ECOG Performance Status`, `Pain Scale`,`Metastatic Cancer`, Education, Sex, Age, `Marital Status`, `Primary Caregiver`, `Monthly Income`, `Total Treatment Expense`, District)
an1$`Primary Caregiver`<-fct_collapse(
an1$`Primary Caregiver`,
Parents=c("Father", "Mother"),
Others=c("16", "Aunti", "Brother", "Nieces", "Relativ", "Self", "sister-", "Sister", "Son in", "Uncle"),
Daughter=c("Daughte")
)
an1$`ECOG Performance Status Cat`<-factor(
an1$`ECOG Performance Status`,
levels = c(
"Symptomatic but completely ambulant",
"Symptomatic, <50% in bed during the day",
"Symptomatic, >50% in bed, but not bed bound",
"Bed Bound"
),
ordered = TRUE
)
an1$`ECOG Performance Status`<-factor(
an1$`ECOG Performance Status`,
levels = c(
"Symptomatic but completely ambulant",
"Symptomatic, <50% in bed during the day",
"Symptomatic, >50% in bed, but not bed bound",
"Bed Bound"
)
)
an1$Education<-fct_collapse(
an1$Education,
"No Education"= c("No education", "n", "Can write name only"),
"Primary Levels"=c("SSC", "High School", "Primary level"),
">=College"=c("HSC", "Graduation", "Post Graduation")
)
an1$Education<-factor(an1$Education,
levels = c("No Education", "Primary Levels", ">=College"))
an1$District<-as.factor(an1$District)
an1$`Pain Scale` <- as.numeric(as.character(an1$`Pain Scale`))
an1$`Pain Category` <- cut(
as.numeric(an1$`Pain Scale`),
breaks = c(-1, 0, 3, 6, 10),
labels = c("No pain", "Mild", "Moderate", "Severe"),
right = TRUE
)
an1$`Pain Category Cat`<-factor(an1$`Pain Category`, levels = c("No pain",  "Mild",     "Moderate", "Severe"), ordered = TRUE)
an1$`Marital Status`<-fct_collapse(
an1$`Marital Status`,
"Not Married"= c("Divorced", "Unmarried", "Widowed/Widower")
)
an1$`Total Treatment Expense (100k)` <- an1$`Total Treatment Expense` / 100000
an1$`Monthly Income (10k)` <- an1$`Monthly Income` / 10000
dhaka_division <- c("Dhaka", "Faridpur", "Gazipur", "Gopalganj", "Kishoreganj",
"Madaripur", "Manikganj", "Munshiganj", "Narayanganj",
"Narsingdi", "Rajbari", "Shariatpur", "Tangail")
an1$Division_Group <- ifelse(an1$District %in% dhaka_division, "Inside Dhaka", "Outside Dhaka")
an1$Division_Group <- factor(an1$Division_Group, levels = c( "Inside Dhaka","Outside Dhaka"))
an1<-an1%>%mutate(across(c(`Does the patient know about illness`, `Metastatic Cancer`), ~fct_recode(., NULL="3")))
an1<-drop_na(an1)
summary(an1)
an1_trimmed<-an1%>%filter(`Total Treatment Expense (100k)`<=quantile(an1$`Total Treatment Expense (100k)`, 0.99, na.rm=TRUE))
table1 <- an1_trimmed %>%
select(`Does the patient know about illness`, Age, `Monthly Income (10k)`,
`Total Treatment Expense (100k)`, `ECOG Performance Status`, `Pain Category`,
`Metastatic Cancer`, Education, Sex, `Marital Status`, `Primary Caregiver`,
Division_Group) %>%
tbl_summary(
by = `Does the patient know about illness`,
statistic = list(all_continuous() ~ "{mean} ({sd})",
all_categorical() ~ "{n} ({p}%)"),
missing = "no"
) %>%
add_p(
test = list(all_continuous() ~ "wilcox.test",   # matches Mann-Whitney used above
all_categorical() ~ "chisq.test")
) %>%
add_overall() %>%
bold_p(t = 0.05) %>%
modify_header(label = "**Characteristic**") %>%
modify_caption("**Table 1. Patient Characteristics by Illness Disclosure Status**")

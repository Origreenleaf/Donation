map_vis_summary_dis$n <- as.numeric(map_vis_summary_dis$n)
range_n <- range(map_vis_summary_dis$n, na.rm = TRUE)
breaks = seq(floor(range_n[1]), ceiling(range_n[2]), length.out = 6)
ggmap<-ggplot(map_vis_summary_dis) +

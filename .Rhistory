bd_sf <- st_read("gadm41_BGD_2.shp")
bd_sf_div <- st_read("gadm41_BGD_1.shp")
replace_values <- function(x, patterns, replacements) {
for (i in seq_along(patterns)) {
x <- ifelse(
grepl(patterns[i],trimws(x), ignore.case = TRUE),
replacements[i],
x
)
}
return(x)
}
patterns_address <- c("Brahamanbaria", "Maulvibazar")
address_replacements <- c("Brahmanbaria", "Moulvibazar")
bd_sf$NAME_2 <- replace_values(bd_sf$NAME_2, patterns_address, address_replacements)
bd_sf_geom <- bd_sf %>%
select(geometry, NAME_1, NAME_2) %>%
mutate(NAME_2 = stringr::str_to_title(NAME_2),
NAME_1=stringr::str_to_title(NAME_1))
bd_sf_geom_div<-bd_sf_div%>%select(geometry,NAME_1)%>%mutate(NAME_1=stringr::str_to_title(NAME_1))
bd_sf_geom$name_join<-bd_sf_geom$NAME_2
map_vis <- nicrh_by_val %>%
select(`Year of Registration`, Age, District, `Diagnosis Group`) %>%
mutate(District = stringr::str_to_title(District)) %>%
left_join(bd_sf_geom, by = c("District" = "name_join"))
map_vis<-map_vis%>%left_join(bd_sf_geom_div,by="NAME_1")
anyNA(map_vis$NAME_2)
map_vis %>%
filter(is.na(NAME_2))%>%distinct(District)
m<-map_vis%>%select(NAME_1, geometry.y)%>%distinct(NAME_1, .keep_all = TRUE)
map_vis_summary_div<-map_vis%>%select(-geometry.x)%>%group_by(NAME_1)%>%summarise(n=n(), Prop_density=n/nrow(map_vis))%>%left_join(m, by="NAME_1")
map_vis_summary_div=v <- st_as_sf(map_vis_summary_div)
Div_view<-ggplot(map_vis_summary_div) +
geom_sf(aes(fill = n), lwd = 0.05, color = "white")+
scale_fill_viridis_c(
option = "magma",
name="",
direction = -1,
breaks= seq(20, 390, length.out = 6)
) + geom_sf_label(aes(label = paste0(NAME_1, "\nPop: ", n)), size=3)+
annotate("text", x = 90.8, y = 26, label = "Division \nSummary", size = 7, family = "fira", hjust=0)+
theme_map() +
theme(
legend.position = "none",
legend.justification = 0.5,
legend.key.size = unit(1.25, "cm"),
legend.key.width = unit(1.75, "cm"),
legend.text = element_text(size = 12),
plot.background = element_rect(color = "grey30", size = 0.2, fill = "grey98"),
legend.margin = margin(),
plot.title = element_text(size = 18, hjust = 0.5),
plot.subtitle = element_text(hjust = 0.5),
plot.margin = margin(-1,0,-1,0, unit = "lines")
)
m<-map_vis%>%select(NAME_2, geometry.x)%>%distinct(NAME_2, .keep_all = TRUE)
map_vis_summary_dis<-map_vis%>%select(-geometry.y)%>%group_by(NAME_2)%>%summarise(n=n(), Prop_density=n/nrow(map_vis))%>%left_join(m, by="NAME_2")
